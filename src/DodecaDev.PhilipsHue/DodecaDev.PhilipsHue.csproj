<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Pinned: manifest.json names this executable, and the generated Strings class lives in this namespace. -->
        <AssemblyName>DodecaDev.PhilipsHue</AssemblyName>
        <RootNamespace>DodecaDev.PhilipsHue</RootNamespace>
        <IsPackable>false</IsPackable>
        <UserSecretsId>DodecaDev.PhilipsHue-PluginDevelopment</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MacroDeck.Plugin.Analyzers" PrivateAssets="all" />
        <PackageReference Include="MacroDeck.Localization" />
        <PackageReference Include="MacroDeck.Plugin.Hosting" />
        <PackageReference Include="MacroDeck.Plugin.Serilog" />
        <PackageReference Include="MacroDeck.Sdk" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DodecaDev.PhilipsHue.Tests" />
    </ItemGroup>

    <!-- The SDK reads the manifest from the content root and resolves the icon against it. -->
    <ItemGroup>
        <Content Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Assets\icon.svg" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
